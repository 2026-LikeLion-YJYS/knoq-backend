MYSQL_DATABASE=knoq
MYSQL_USER=knoq
MYSQL_PASSWORD=replace-with-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

JWT_SECRET=replace-with-base64-encoded-secret-at-least-32-bytes
STAFF_PIN=replace-with-staff-pin
STAFF_TOKEN_EXPIRY_HOURS=12
SESSION_EXPIRY_MINUTES=60
SAVED_PRODUCT_MAX_PRODUCTS=9
RECOGNITION_THRESHOLD_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173

OPENAI_API_KEY=replace-with-openai-api-key

# Use update only for the first startup of an empty database.
# Change this to validate after all tables have been created successfully.
JPA_DDL_AUTO=update
